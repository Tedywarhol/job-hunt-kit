# Interface graphique du Job-Hunt Kit : copiez ce fichier en .env (jamais versionné).

# Application locale pour une seule personne : pas de page de connexion.
# Sans cette ligne, l'application demande de créer un compte au premier lancement.
AUTH_DISABLED=true

# Chat avec un modèle local (Ollama) : aucune clé d'API, aucune donnée ne quitte la machine.
# Installez Ollama, téléchargez un modèle (par exemple ollama pull qwen3.5:9b).
# AGENT_ENGINE=ai-sdk:ollama
# OLLAMA_BASE_URL=http://localhost:11434
#
# Le chat ne propose que les modèles de cette liste (en plus de llama3.1, llama3.2, mistral et codestral,
# fournis par le framework). Ajoutez ici ceux que vous avez installés (ollama list), séparés par des virgules.
# Le chat envoie les actions du kit comme outils : un modèle sans la capacité « tools » (gemma3:4b par
# exemple, voir `ollama show <modèle>`) répond à une conversation mais échoue dès qu'une action est utile.
# OLLAMA_MODELS=qwen2.5:3b,qwen3.5:9b,gemma4:12b,gemma3:4b
# OLLAMA_DEFAULT_MODEL=qwen3.5:9b

# Chat avec Claude : saisissez votre clé dans Réglages, ou ici (jamais dans Git).
# ANTHROPIC_API_KEY=

# Données fictives dans le tableau de bord, pour essayer l'écran ou le photographier.
# HUNT_UI_DEMO=1

# Obligatoire pour la version construite (pnpm build puis pnpm start), pas pour pnpm dev.
# Générez-le une fois : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=

# Pour choisir le port de la version construite : PORT=3056 pnpm start
