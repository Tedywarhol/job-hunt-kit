# Interface graphique du Job-Hunt Kit : copiez ce fichier en .env (jamais versionné).

# Application locale pour une seule personne : pas de page de connexion.
# Sans cette ligne, l'application demande de créer un compte au premier lancement.
AUTH_DISABLED=true

# Chat avec un modèle local (Ollama) : aucune clé d'API, aucune donnée ne quitte la machine.
# Installez Ollama, téléchargez un modèle (par exemple ollama pull qwen3.5:9b) puis choisissez-le dans le chat.
# AGENT_ENGINE=ai-sdk:ollama
# OLLAMA_BASE_URL=http://localhost:11434

# Chat avec Claude : saisissez votre clé dans Réglages, ou ici (jamais dans Git).
# ANTHROPIC_API_KEY=

# Si l'application tourne un jour hors de votre machine, remplacez AUTH_DISABLED par un secret stable.
# BETTER_AUTH_SECRET=
