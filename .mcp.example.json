{
  "mcpServers": {
    "mcp-server-linkedin": {
      "command": "uvx",
      "args": ["mcp-server-linkedin@latest"],
      "env": { "UV_HTTP_TIMEOUT": "300" }
    },
    "windows-mcp": {
      "command": "uvx",
      "args": ["windows-mcp", "serve"]
    },
    "excalidraw-studio": {
      "type": "http",
      "url": "http://localhost:3001/mcp"
    }
  }
}
